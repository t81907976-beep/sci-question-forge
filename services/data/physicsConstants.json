  "thermodynamicProcesses": {
    "isothermal": {
      "name": "Isothermal Process",
      "conditions": "T = constant",
      "implications": [
        "If pressure increases, volume must decrease (Boyle's Law)",
        "If volume increases, pressure must decrease",
        "ΔU = 0 for ideal gas",
        "Q = W = nRT·ln(V_f/V_i)"
      ],
      "violations": [
        "Pressure increases but volume also increases",
        "Pressure and volume change in same direction"
      ]
    },
    "isobaric": {
      "name": "Isobaric Process",
      "conditions": "P = constant",
      "implications": [
        "If temperature increases, volume must increase (Charles's Law)",
        "If temperature decreases, volume must decrease",
        "ΔU = nC_v·ΔT",
        "Q = nC_p·ΔT"
      ],
      "violations": [
        "Temperature increases but volume decreases",
        "Temperature and volume change in opposite directions"
      ]
    },
    "isochoric": {
      "name": "Isochoric Process",
      "conditions": "V = constant",
      "implications": [
        "If temperature increases, pressure must increase (Gay-Lussac's Law)",
        "If temperature decreases, pressure must decrease",
        "W = 0",
        "ΔU = Q = nC_v·ΔT"
      ],
      "violations": [
        "Temperature increases but pressure decreases",
        "Temperature and pressure change in opposite directions"
      ]
    },
    "adiabatic": {
      "name": "Adiabatic Process",
      "conditions": "Q = 0 (no heat transfer)",
      "implications": [
        "System is thermally isolated",
        "ΔU = -W",
        "Expansion causes temperature decrease",
        "Compression causes temperature increase"
      ],
      "violations": [
        "Heat transfer mentioned (contradicts adiabatic assumption)",
        "Cooling during compression without stating external cooling"
      ]
    }
  },
