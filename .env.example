# LLM 网关（OpenAI 兼容），dev server 会把 /api/oneapi 代理到这里
VITE_GATEWAY_BASE_URL=https://api.anthropic.com
VITE_ANTHROPIC_API_KEY=your_gateway_api_key_here

# 可选：覆盖网关暴露的模型清单，格式为 `厂商:模型ID` 列表
# VITE_GATEWAY_MODELS="Claude:claude-opus-5,Claude:claude-sonnet-5,DeepSeek:deepseek-reasoner"

# 可选：直连 DeepSeek 官方 API（provider 选 deepseek 时使用）
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
